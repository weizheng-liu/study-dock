{
  "manifest_version": 3,
  "name": "Study Dock · 课程采集助手",
  "description": "从你已登录的 Canvas 和 Classroom 页面读取课程、作业和资料，汇总到本机学习空间。",
  "version": "0.3.0",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://nu.instructure.com/*",
    "https://classroom.google.com/*",
    "http://127.0.0.1:8840/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Study Dock 采集助手"
  },
  "content_scripts": [
    {
      "matches": [
        "https://nu.instructure.com/*",
        "https://classroom.google.com/*"
      ],
      "js": [
        "collector.js",
        "text_entry.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "key": ""
}
